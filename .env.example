# Neon or another PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Used only by `pnpm db:seed` to create/update the first administrator.
# Choose a strong value before deploying. Do not commit a real .env file.
ADMIN_EMAIL="organizer@example.edu"
ADMIN_PASSWORD="change-this-before-running-seed"
